# CORS - The URL of your deployed React app (e.g. https://activelife.vercel.app)
FRONTEND_URL=

# AI Integrations
OPENROUTER_API_KEY=

# Email and SMS OTP configuration
EMAIL_SENDER=
EMAIL_PASSWORD=
