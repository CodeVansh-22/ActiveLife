# Server configuration
PORT=5001
FLASK_ENV=development

# MongoDB connection URI (e.g. mongodb+srv://<username>:<password>@cluster.mongodb.net/ActiveLife)
MONGO_URI=

# JWT Secret Key for token signing
JWT_SECRET=

# Secret Key for Flask sessions / signed cookies
SECRET_KEY=

# Dynamic CORS configuration - The URL of your deployed frontend (e.g. https://activelife.vercel.app)
FRONTEND_URL=

# AI Integrations
OPENROUTER_API_KEY=

# OTP Notification Services
EMAIL_SENDER=
EMAIL_PASSWORD=
FAST2SMS_API_KEY=
